# --- Database ---
POSTGRES_USER=seo
POSTGRES_PASSWORD=seo
POSTGRES_DB=seo_link_building
POSTGRES_PORT=5432

# Used by the API/worker containers (matches the postgres service above)
DATABASE_URL=postgresql+psycopg2://seo:seo@db:5432/seo_link_building

# --- App ---
ENV=development
SECRET_KEY=change-me-in-prod

# --- Auth (Sprint 2) ---
# Comma-separated dashboard origin(s); ignored in development (ENV=development
# allows every origin instead, since no credentials/cookies are sent).
FRONTEND_ORIGINS=

# --- Dashboard (Sprint 2) ---
# Baked into the apps/web build (see apps/web/Dockerfile) — the browser's
# URL for the API, not a container-to-container one.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- AI providers (Sprint 3) ---
# At least one is required for the `worker` service to actually process
# ai_jobs — see apps/api/app/ai/providers/factory.py (OpenAI preferred,
# Claude as fallback). Without either, `worker` exits with a clear error
# and docker-compose just keeps restarting it.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
